<# : Instalador Albaranes Hispaoffice - no editar estas lineas
@echo off
setlocal
title Albaranes Hispaoffice - instalador
set "ARG="
if /i "%~1"=="/desinstalar" set "ARG=/desinstalar"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$f='%~f0'; & ([ScriptBlock]::Create([IO.File]::ReadAllText($f, [Text.Encoding]::UTF8))) %ARG%"
echo.
pause
exit /b
#>
# ====================================================================
#  Instalador de Albaranes -> ClasGes (Hispaoffice)      PJLR 2026.08
#  Solo crea accesos directos a la aplicacion web. No instala
#  programas, no toca ClasGes ni necesita permisos de administrador.
# ====================================================================
$ErrorActionPreference = 'Stop'
$URL    = 'https://appalbaranhispaoffice.netlify.app/'
$NOMBRE = 'Albaranes Hispaoffice'
$dir    = Join-Path $env:LOCALAPPDATA 'AppAlbaranesHispaoffice'
$ico    = Join-Path $dir 'hispaoffice.ico'
$desk   = [Environment]::GetFolderPath('Desktop')
$menu   = Join-Path ([Environment]::GetFolderPath('Programs')) 'Hispaoffice'
$accesos = @((Join-Path $desk "$NOMBRE.lnk"), (Join-Path $menu "$NOMBRE.lnk"))
$quitar  = $args -contains '/desinstalar'

Write-Host ''
Write-Host '  ALBARANES -> CLASGES  -  HISPAOFFICE' -ForegroundColor Yellow
Write-Host '  ------------------------------------'

if ($quitar) {
  foreach ($a in $accesos + (Join-Path $desk "$NOMBRE.url")) { if (Test-Path -LiteralPath $a) { Remove-Item -LiteralPath $a -Force; Write-Host "  Quitado: $a" } }
  if ((Test-Path $menu) -and -not (Get-ChildItem $menu)) { Remove-Item $menu -Force }
  if (Test-Path $dir) { Remove-Item $dir -Recurse -Force }
  Write-Host ''; Write-Host '  Accesos directos eliminados. Tus datos de ClasGes no se han tocado.' -ForegroundColor Green
  return
}

