[IO.File]::WriteAllBytes($ico, [Convert]::FromBase64String(($b64 -replace '\s', '')))

# 2. Navegador: Chrome o Edge (la app necesita uno de los dos para acceder a la carpeta de ClasGes)
$cands = @(
  "$env:ProgramFiles\Google\Chrome\Application\chrome.exe",
  "${env:ProgramFiles(x86)}\Google\Chrome\Application\chrome.exe",
  "$env:LOCALAPPDATA\Google\Chrome\Application\chrome.exe",
  "${env:ProgramFiles(x86)}\Microsoft\Edge\Application\msedge.exe",
  "$env:ProgramFiles\Microsoft\Edge\Application\msedge.exe"
)
$nav = $cands | Where-Object { $_ -and (Test-Path -LiteralPath $_) } | Select-Object -First 1

# 3. Accesos directos (Escritorio y menu Inicio > Hispaoffice)
$sh = New-Object -ComObject WScript.Shell
foreach ($a in $accesos) {
  $lnk = $sh.CreateShortcut($a)
  if ($nav) {
    $lnk.TargetPath = $nav
    $lnk.Arguments  = "--app=$URL"
    $lnk.WorkingDirectory = Split-Path $nav
  } else {
    $lnk.TargetPath = $URL
  }
  $lnk.IconLocation = "$ico,0"
  $lnk.Description  = 'Importador de albaranes de proveedor a ClasGes 7 - Hispaoffice'
  $lnk.Save()
  Write-Host "  Creado: $a"
}

Write-Host ''
if ($nav) { Write-Host "  Se abrira en su propia ventana con: $(Split-Path $nav -Leaf)" }
else      { Write-Host '  AVISO: no se ha encontrado Chrome ni Edge. La aplicacion necesita uno de los dos.' -ForegroundColor Red }
Write-Host '  Primera vez: pulsa "Elegir carpeta de ClasGes" y selecciona C:\Clasges7.'
Write-Host ''
Write-Host '  Instalacion terminada.' -ForegroundColor Green
